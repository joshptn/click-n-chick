{
  "expo": {
    "name": "Click n Chick",
    "slug": "click-n-chick",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f58c2f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.joshptn.clicknchick"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ff8904",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 80
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Click n Chick uses your photos for your profile picture and your discount ID.",
          "cameraPermission": "Click n Chick uses the camera to take your profile picture and a photo of your discount ID.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Click n Chick uses your location to pin where your delivery should go."
        }
      ]
    ],
    "scheme": "clicknchick"
  }
}
