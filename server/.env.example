APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# PAYMONGO_SECRET=api test key
FRONTEND_URL=http://localhost:5173

# Comma-separated list of EXACT origins (scheme + host + port) allowed to call /api/*.
# Wildcards are intentionally unsupported. To demo through a tunnel, append the full
# origin, e.g. ...,https://unrung-mack-unlawfully.ngrok-free.dev
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Laravel Reverb (replaced the former FastAPI relay)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# SMS / OTP delivery. driver=log keeps the code in the log and never
# calls Semaphore. Set to "semaphore" only for a deliberate live test.
SMS_DRIVER=log
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# --- Mail -------------------------------------------------------------------
# Gmail SMTP. MAIL_PASSWORD must be a Google App Password (16 chars, generated
# at myaccount.google.com/apppasswords with 2-Step Verification enabled) - a
# regular account password is rejected by Gmail's SMTP server.
#
# Left on 'log' until real credentials are in place: with MAIL_MAILER=log the
# verification email is written to storage/logs/laravel.log and nothing is
# dispatched, so the email registration path is exercisable end to end without
# working SMTP. Flip to 'smtp' once MAIL_USERNAME/MAIL_PASSWORD are filled in.
MAIL_MAILER=log
# Port 587 uses STARTTLS, which is what Gmail expects; leave MAIL_SCHEME unset
# for that. For implicit TLS use port 465 with MAIL_SCHEME=smtps.
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@clicknchick.test"
MAIL_FROM_NAME="${APP_NAME}"
