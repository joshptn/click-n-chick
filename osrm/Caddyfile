# HTTPS in front of OSRM. Caddy gets and renews the certificate by itself
# (Let's Encrypt), which needs ports 80 and 443 open and OSRM_DOMAIN pointing
# at this server. Values in {$...} come from osrm/.env.

{$OSRM_DOMAIN} {
	# For the uptime monitor: a real lookup at the shop, no token needed.
	# A working server answers with {"code":"Ok", ...}.
	handle /health {
		rewrite * /nearest/v1/driving/{$STORE_LNG},{$STORE_LAT}?number=1
		reverse_proxy osrm:5000
	}

	# Routes, only for requests carrying our token (the API sends it).
	@ours {
		path /route/v1/*
		header Authorization "Bearer {$OSRM_TOKEN}"
	}
	handle @ours {
		reverse_proxy osrm:5000
	}

	# Everything else, including a missing or wrong token.
	handle {
		respond "Unauthorized" 401
	}
}
