# Copy to .env on the routing server (cp .env.example .env) and fill it in.
# .env is never committed: it holds the token. No spaces around the = signs.

# Your DuckDNS name, in full, e.g. clicknchick-routing.duckdns.org
OSRM_DOMAIN=
# The token shown at the top of duckdns.org once you are signed in.
DUCKDNS_TOKEN=

# A long random secret. Make one on the server with:  openssl rand -hex 32
# The same value goes into OSRM_TOKEN on Render and in server/.env.
OSRM_TOKEN=

# The shop, the same as STORE_ORIGIN_LAT / STORE_ORIGIN_LNG in the API.
STORE_LAT=14.958753
STORE_LNG=120.758469

# How much map to keep around the shop, in km. Keep it above the delivery
# limit (STORE_MAX_DRIVING_KM, 45) with room to spare. Rerun update-map.sh
# after changing it, or after changing the shop's location.
AREA_RADIUS_KM=60

# The OSRM version. Changing it needs a fresh map: rerun update-map.sh.
OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:v26.11.0-debian
